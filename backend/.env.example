# Copiar a .env (nunca commitear .env real — ver .gitignore).
# Cadena de conexión a PostgreSQL (local o Cloud SQL vía proxy).
DATABASE_URL="postgresql://eltesoro:eltesoro@localhost:5432/eltesoro_dev?schema=public"

# --- Módulo 04 — Cuentas de usuario ---
# URL pública del frontend: se usa para armar los enlaces de verificación
# de correo y recuperación de contraseña.
FRONTEND_URL="http://localhost:3000"

# Secreto para firmar los access tokens (JWT). Generar uno fuerte y único
# por entorno, ej.: openssl rand -hex 32
JWT_ACCESS_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
# true en producción (cookies solo por HTTPS); false permite probar en
# localhost sin TLS.
COOKIE_SECURE=false

# SEG-02: secreto compartido con el proxy de Next
# (frontend/.env → INTERNAL_PROXY_SECRET, mismo valor). Permite confiar en
# el header con la IP real del cliente para el límite de intentos de login;
# si se deja vacío, el rate limit vuelve a compartirse entre todos los
# usuarios (comportamiento actual, nunca peor). Generar con: openssl rand -hex 32
INTERNAL_PROXY_SECRET=""

# Brevo (correo transaccional): https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""
# Debe ser un remitente verificado en Brevo (Senders, Domains & Dedicated IPs
# > Senders) o Brevo rechaza el envío con "Sending has been rejected...".
EMAIL_FROM="no-responder@eltesoro.gt"
EMAIL_FROM_NAME="Almacén El Tesoro"
