# Copiar a .env (nunca commitear .env real — ver .gitignore).
# Cadena de conexión a PostgreSQL (local o Cloud SQL vía proxy).
DATABASE_URL="postgresql://eltesoro:eltesoro@localhost:5432/eltesoro_dev?schema=public"

# --- Módulo 04 — Cuentas de usuario ---
# URL pública del frontend: se usa para armar los enlaces de verificación
# de correo y recuperación de contraseña.
FRONTEND_URL="http://localhost:3000"

# Secreto para firmar los access tokens (JWT). Generar uno fuerte y único
# por entorno, ej.: openssl rand -hex 32
JWT_ACCESS_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_HOURS=1
# true en producción (cookies solo por HTTPS); false permite probar en
# localhost sin TLS.
COOKIE_SECURE=false

# SEG-02: secreto compartido con el proxy de Next
# (frontend/.env → INTERNAL_PROXY_SECRET, mismo valor). Permite confiar en
# el header con la IP real del cliente para el límite de intentos de login;
# si se deja vacío, el rate limit vuelve a compartirse entre todos los
# usuarios (comportamiento actual, nunca peor). Generar con: openssl rand -hex 32
INTERNAL_PROXY_SECRET=""

# Brevo (correo transaccional): https://app.brevo.com/settings/keys/api
BREVO_API_KEY=""
# Debe ser un remitente verificado en Brevo (Senders, Domains & Dedicated IPs
# > Senders) o Brevo rechaza el envío con "Sending has been rejected...".
EMAIL_FROM="no-responder@eltesoro.gt"
EMAIL_FROM_NAME="Almacén El Tesoro"

# --- Módulo 06 — Checkout ---
# Minutos que dura la reserva de stock de una orden en `pendiente_pago`
# antes de liberarse sola, y cada cuánto corre el barrido que las libera.
# STOCK_RESERVATION_TTL_MINUTES=60
# STOCK_RESERVATION_SWEEP_INTERVAL_MS=30000

# --- Módulo 07 — Pagos en línea (CyberSource/VisaNet, Secure Acceptance
# Hosted Checkout — el método que Neonet pidió instalar) ---
# Vacías por ahora: mientras el ajuste `pagos_en_linea_habilitado` (tabla
# settings) esté en false, el checkout muestra "Cotizar" y nunca lee estas
# variables. Nunca poner aquí credenciales reales ni commitear este archivo
# con valores — usar un .env local (ya está en .gitignore). Se obtienen del
# perfil de Secure Acceptance en Business Center (Payment Configuration >
# Secure Acceptance Profiles), no de "Key Management" (esa es para la API
# REST v2, un método de integración distinto que este módulo no usa).
CYBERSOURCE_ENV="sandbox"
CYBERSOURCE_PROFILE_ID=""
CYBERSOURCE_ACCESS_KEY=""
CYBERSOURCE_SECRET_KEY=""
# URL pública de este backend — el navegador vuelve aquí después de pagar
# en la página hospedada de CyberSource. En local, http://localhost:PORT
# funciona (es el navegador del desarrollador el que redirige, no un
# servidor); en staging/producción debe ser la URL real del backend.
BACKEND_URL="http://localhost:8080"

# --- Módulo 08 — Panel de administración ---
# Bucket de Cloud Storage para fotos subidas desde el panel — mismo bucket
# que usa el importador de Excel del Módulo 02.
PRODUCT_IMAGES_BUCKET="eltesoro-product-images-staging"

# --- Módulo 07 — FEL ---
# "Enchufe" sin certificador conectado: mientras el ajuste `fel_habilitado`
# (tabla settings) esté en false u omitido, las facturas quedan en
# `pendiente` (fel.service.ts) sin bloquear la venta. No hay variables de
# certificador todavía — se agregan cuando exista trámite con SAT.
