// Modelo de catálogo — Módulo 01 (fundacional).
// Fuente de verdad: docs/plan/01-fundacional.md + skill retail-catalog-data-model.
// No agrega endpoints ni lógica de negocio: solo estructura y migraciones.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  activo
  borrador
  descontinuado
}

enum CollectionType {
  manual
  automatica
}

enum ProductRelationType {
  relacionado
  complementario
  parte_de_set
}

/// Categoría de catálogo. Auto-referenciada (parentId) para soportar
/// jerarquía de profundidad arbitraria — la taxonomía real (departamento >
/// categoría > subcategoría) todavía no está aprobada por el negocio, así
/// que el esquema no la limita a un número fijo de niveles.
model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  nombre      String
  descripcion String?
  imagenUrl   String?
  orden       Int      @default(0)

  parentId String?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@map("categories")
}

/// Producto general (concepto). Las variantes vendibles viven en ProductVariant.
model Product {
  id                String        @id @default(uuid())
  slug              String        @unique
  nombre            String
  descripcionCorta  String?
  descripcionLarga  String?
  marca             String?
  especificaciones  Json?
  estado            ProductStatus @default(borrador)

  categoriaId String
  categoria   Category @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  /// Texto plano sin acentos (nombre + marca + categoría) mantenido por quien
  /// escribe el producto (importador por ahora). Evita depender de una
  /// extensión de PostgreSQL (unaccent) para que "sarten" encuentre "sartén".
  busqueda String @default("")

  /// CAT-02/NUEVO-01: copia del precio mínimo entre variantes activas y de
  /// si alguna tiene stock vendible (cantidadDisponible - cantidadReservada
  /// > 0, ver shared/src/inventory.ts). Mantenida automáticamente por
  /// triggers de Postgres sobre `product_variants` e `inventory`
  /// (migración 20260914090000_nuevo01_trigger_agregados_producto) — no por
  /// código de aplicación, para que ningún caller futuro (checkout del
  /// Módulo 06, panel admin del Módulo 08) pueda olvidarse de mantenerla.
  /// Existen solo para poder ordenar, filtrar y paginar por SQL en
  /// `listProductsByCategory` sin cargar todas las variantes de la
  /// categoría en memoria — nunca se leen como fuente de verdad del precio
  /// real (esa sigue siendo `ProductVariant.precio`).
  precioDesde Decimal? @db.Decimal(10, 2)
  disponible  Boolean  @default(false)

  /// Campos B2B latentes (módulo 11 los activa). Precio mayorista y compra
  /// mínima a nivel de producto; sin uso hasta el portal mayorista, pero
  /// deben existir desde ya para no migrar después.
  precioMayorista          Decimal? @db.Decimal(10, 2)
  cantidadMinimaMayorista  Int?

  /// Metadatos de procedencia: el catálogo se poblará desde un API externo
  /// de productos (aún no provisto). Estos campos permiten mapear cada
  /// producto a su origen y detectar cambios sin definir todavía el
  /// mecanismo de sincronización (eso es alcance del módulo 02).
  externalId     String?
  externalSource String?
  rawPayload     Json?
  syncedAt       DateTime?

  variants  ProductVariant[]
  images    ProductImage[]
  collections ProductCollection[]

  relatedFrom ProductRelation[] @relation("ProductRelationSource")
  relatedTo   ProductRelation[] @relation("ProductRelationTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([externalSource, externalId])
  @@index([categoriaId])
  @@index([busqueda])
  @@index([categoriaId, precioDesde])
  @@index([categoriaId, disponible])
  @@map("products")
}

/// Variante vendible: SKU, precio y stock propios.
model ProductVariant {
  id     String  @id @default(uuid())
  sku    String  @unique
  activo Boolean @default(true)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  precio            Decimal  @db.Decimal(10, 2)
  precioComparativo Decimal? @db.Decimal(10, 2)

  pesoKg      Decimal? @db.Decimal(10, 3)
  dimensiones Json?

  imagenPrincipalId String?       @unique
  imagenPrincipal   ProductImage? @relation("VariantMainImage", fields: [imagenPrincipalId], references: [id], onDelete: SetNull)

  externalId String?

  atributos VariantAttributeValue[]
  images    ProductImage[]          @relation("VariantImages")
  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

/// Imagen de producto o de una variante específica (ej. por color).
/// `url` es solo la referencia al archivo en Cloud Storage (GCS) — la base
/// de datos nunca almacena los bytes de la imagen, solo esta cadena.
model ProductImage {
  id               String  @id @default(uuid())
  url              String
  orden            Int     @default(0)
  textoAlternativo String?

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation("VariantImages", fields: [variantId], references: [id], onDelete: Cascade)

  mainForVariant ProductVariant? @relation("VariantMainImage")

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@map("product_images")
}

/// Tipo de atributo que genera variante (Tamaño, Color, Material...).
model AttributeType {
  id     String @id @default(uuid())
  nombre String @unique

  values AttributeValue[]

  @@map("attribute_types")
}

model AttributeValue {
  id     String @id @default(uuid())
  valor  String

  attributeTypeId String
  attributeType   AttributeType @relation(fields: [attributeTypeId], references: [id], onDelete: Cascade)

  variants VariantAttributeValue[]

  @@unique([attributeTypeId, valor])
  @@map("attribute_values")
}

model VariantAttributeValue {
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  @@id([variantId, attributeValueId])
  @@map("variant_attribute_values")
}

/// Agrupaciones que no son la jerarquía de categorías (Novedades, Sets...).
model Collection {
  id     String         @id @default(uuid())
  slug   String         @unique
  nombre String
  tipo   CollectionType @default(manual)

  products ProductCollection[]

  createdAt DateTime @default(now())

  @@map("collections")
}

model ProductCollection {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

/// "También te puede interesar" / "Compra junto a esto" / sets.
model ProductRelation {
  productId String
  product   Product @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)

  relatedProductId String
  relatedProduct   Product @relation("ProductRelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)

  tipo ProductRelationType

  @@id([productId, relatedProductId, tipo])
  @@map("product_relations")
}

/// Stock por variante. cantidadDisponible y cantidadReservada se manejan
/// por separado a propósito (ver skill catalog-data-model, sección 6): la
/// lógica de reserva/liberación es del módulo de checkout, este modelo solo
/// la soporta. bodegaId queda listo para multi-bodega futura.
///
/// NUEVO-02: "stock vendible" (lo que de verdad se le puede ofrecer a un
/// cliente nuevo) es cantidadDisponible - cantidadReservada, nunca
/// cantidadDisponible sola — ver `stockVendible` en shared/src/inventory.ts,
/// usado por carrito, ficha y listados. Un trigger de Postgres mantiene
/// `Product.disponible` con el mismo criterio (ver NUEVO-01 arriba).
model Inventory {
  variantId String         @id
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  cantidadDisponible Int @default(0)
  cantidadReservada  Int @default(0)
  umbralStockBajo    Int @default(0)

  bodegaId String?

  updatedAt DateTime @updatedAt

  @@map("inventory")
}

// ---------------------------------------------------------------------------
// Módulo 04 — Cuentas de usuario. Roles desde el día uno (customer/admin/
// wholesale) aunque admin y wholesale no tengan UI todavía (ver módulos 08 y
// 11). departamento/municipio de Address son String validados en la capa de
// aplicación contra la lista fija en shared/src/guatemala.ts, no un enum de
// Prisma: son ~340 municipios y una migración por cada cambio sería absurdo.
// ---------------------------------------------------------------------------

enum Role {
  customer
  admin
  /// SEG-04: personal de tienda (consulta de precio/stock en
  /// /staff/inventario). Menos privilegios que admin; el Módulo 08 le
  /// agregará su propio panel sin volverlo admin.
  staff
  wholesale
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  nombre       String
  telefono     String?
  /// NIT guatemalteco o "CF" (Consumidor Final). Formato validado en
  /// validators/, no aquí.
  nit          String?
  role         Role      @default(customer)
  emailVerifiedAt DateTime?

  addresses                Address[]
  emailVerificationTokens  EmailVerificationToken[]
  passwordResetTokens      PasswordResetToken[]
  refreshTokens            RefreshToken[]
  cart                     Cart?
  orders                   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

/// Libreta de direcciones del cliente, restringida a Guatemala en fase 1.
model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  alias              String?
  nombreDestinatario String
  telefono           String
  departamento       String
  municipio          String
  direccion          String
  referencia         String?
  esPredeterminada   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("addresses")
}

/// Token de un solo uso para verificar el correo de registro. Se almacena
/// solo el hash (sha256) — el valor crudo va únicamente en el enlace del
/// correo, nunca en la base de datos.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("email_verification_tokens")
}

/// Token de un solo uso para "olvidé mi contraseña". Mismo esquema de hash
/// que EmailVerificationToken.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Suscriptores al boletín de ofertas (popup del home). Independiente de
/// User: suscribirse no requiere cuenta, y una cuenta no implica
/// suscripción — son consentimientos distintos.
model NewsletterSubscriber {
  id        String   @id @default(uuid())
  nombre    String
  apellido  String
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_subscribers")
}

/// Refresh token opaco (no JWT): permite revocar sesiones individuales en
/// logout o al cambiar contraseña, algo que un JWT stateless no soporta.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Módulo 05 — Carrito. Anónimo (cartToken en cookie, 30 días — confirmado con
// el negocio) o de cuenta (userId), fusionados al iniciar sesión (ver
// cart.service.ts). Este módulo solo VALIDA stock contra
// Inventory.cantidadDisponible; la reserva (cantidadReservada) es exclusiva
// del checkout (Módulo 06) — ver docs/plan/05-carrito.md sección 6.
// ---------------------------------------------------------------------------

enum CartStatus {
  activo
  convertido
  abandonado
}

model Cart {
  id     String  @id @default(uuid())
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Identificador opaco del carrito de invitado (cookie httpOnly, no JWT:
  /// no necesita payload, solo debe ser impredecible y verificable contra la
  /// tabla). Null en carritos de cuenta.
  cartToken String? @unique

  estado CartStatus @default(activo)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id     String @id @default(uuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  cantidad Int

  /// Precio al momento de agregar/actualizar cantidad — referencia para
  /// avisar si cambió, nunca la fuente de verdad del total mostrado (ese
  /// siempre se recalcula con el precio actual de la variante).
  precioUnitarioCongelado Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// CAT-06 — Banners del home. No hay panel admin en el proyecto todavía, así
// que se administran con `npm run manage-banners` (scripts/manage-banners.ts)
// corriendo contra la base de datos real — sin pantalla web ni login nuevo.
// Si no hay ningún banner activo, el home usa el comportamiento automático
// (bloques armados con fotos de producto) que ya tenía.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Módulo 06 — Checkout. Crea la orden y reserva stock; se detiene antes del
// cobro (docs/plan/06-checkout.md). Decisiones de negocio del 14-sep:
// transportistas Cargo Expreso y Forza con tarifa por departamento, recoger
// en tienda gratis, envío gratis desde un monto parametrizable (`settings`),
// reserva de stock 60 minutos, sin cupones en fase 1.
// ---------------------------------------------------------------------------

enum OrderStatus {
  pendiente_pago
  pagado
  en_preparacion
  enviado
  entregado
  cancelado
}

enum ShippingCarrier {
  cargo_expreso
  forza
}

/// Tarifa de envío a domicilio por transportista + departamento (decisión
/// del 14-sep: tarifa por departamento, no plana ni por peso). "Recoger en
/// tienda" no tiene fila aquí — su costo es 0 por definición, ver
/// shipping.service.ts.
model ShippingRate {
  id            String          @id @default(uuid())
  transportista ShippingCarrier
  departamento  String
  costo         Decimal         @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([transportista, departamento])
  @@map("shipping_rates")
}

/// Ajustes de negocio de valor simple (clave/valor), parametrizables sin
/// desplegar código. Primer uso: `envio_gratis_umbral` (monto de subtotal a
/// partir del cual el envío es gratis — puede variar según temporada, según
/// el negocio).
model Setting {
  clave String @id
  valor String

  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Contador atómico del correlativo de orden por año (`AET-2026-00001`).
/// Una fila por año; se incrementa dentro de la misma transacción que crea
/// la orden — ver utils/orderNumber.ts.
model OrderCounter {
  anio   Int @id
  ultimo Int @default(0)

  @@map("order_counters")
}

/// Orden creada al final del checkout (docs/plan/06-checkout.md sección 2).
/// Snapshot completo de precios/productos/envío/facturación al momento de
/// comprar — nunca cambia si el catálogo cambia después. Se detiene antes
/// del cobro: nace en `pendiente_pago` y el Módulo 07 la mueve de ahí.
model Order {
  id     String @id @default(uuid())
  numero String @unique

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// Checkout de invitado (skill retail-cart-checkout, sección 5): contacto
  /// mínimo para poder ubicar/contactar la orden sin cuenta.
  invitadoEmail    String?
  invitadoTelefono String?

  estado            OrderStatus @default(pendiente_pago)
  /// Motivo cuando `estado = cancelado` (ej. "expirada_reserva"). Informativo,
  /// no maneja lógica — la lógica real de expiración vive en
  /// order.service.ts.
  motivoCancelacion String?

  /// Datos de facturación FEL (NIT o "CF" + nombre/razón social) — viajan
  /// con la orden; la emisión de la factura es del Módulo 07.
  facturacionNit    String
  facturacionNombre String

  /// "recoger_tienda" | "cargo_expreso" | "forza" — snapshot del nombre para
  /// mostrarlo igual aunque cambie después la tarifa o el catálogo de
  /// métodos.
  metodoEnvioCodigo String
  metodoEnvioNombre String
  /// Snapshot de la dirección de envío (igual forma que Address). Null si el
  /// método fue "recoger_tienda".
  direccionEnvio    Json?

  // CAR-05/06: todo monto en Decimal(10,2), calculado con shared/src/money.ts
  // y expuesto por la API como texto decimal fijo — nunca number.
  subtotal   Decimal @db.Decimal(10, 2)
  costoEnvio Decimal @db.Decimal(10, 2)
  descuento  Decimal @db.Decimal(10, 2) @default(0)
  total      Decimal @db.Decimal(10, 2)
  /// IVA ya incluido en los precios (práctica GT) — este campo es solo el
  /// desglose informativo para el resumen/recibo, no se suma al total.
  ivaIncluidoInformativo Decimal @db.Decimal(10, 2)

  /// Token opaco (mismo patrón que el carrito, ver utils/tokens.ts) que
  /// permite a un invitado sin cuenta consultar su propia orden después de
  /// crearla. Solo se guarda el hash; el valor crudo se entrega una vez en
  /// la respuesta de creación.
  accessTokenHash String? @unique

  /// Null cuando la reserva ya no aplica (orden pagada/cancelada/expirada).
  fechaExpiracionReserva DateTime?
  /// true una vez que la reserva de esta orden ya se liberó (por expiración
  /// o cancelación) — evita liberar dos veces la misma cantidad.
  reservaLiberada        Boolean   @default(false)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([estado, fechaExpiracionReserva])
  @@map("orders")
}

/// Línea de orden: snapshot inmutable copiado de `CartItem` al momento de
/// crear la orden (docs/plan/06-checkout.md sección 7.1) — nunca se relee del
/// catálogo después. `variantId` es opcional para no atar el historial de
/// compras a que la variante siga existiendo.
model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  nombreProducto String
  sku            String
  imagenUrl      String?
  atributos      Json?

  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model Banner {
  id        String   @id @default(uuid())
  titulo    String
  subtitulo String?
  imagenUrl String
  enlace    String
  orden     Int      @default(0)
  activo    Boolean  @default(true)

  /// Ambos opcionales: un banner sin fechas está activo indefinidamente
  /// mientras `activo` sea true.
  fechaInicio DateTime?
  fechaFin    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([activo, orden])
  @@map("banners")
}
