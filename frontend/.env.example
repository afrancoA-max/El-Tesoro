# URL base de la API de catálogo (Módulo 02). En staging apunta al servicio
# de Cloud Run del backend; en local, http://localhost:8080/api.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# URL pública donde vive este frontend — se usa para canonical/sitemap/OG.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEG-02: secreto compartido con el backend (backend/.env →
# INTERNAL_PROXY_SECRET, mismo valor) para que el proxy same-origin
# (src/app/api/[...path]/route.ts) le pase la IP real del cliente al
# rate limit de login. Vacío = no se envía el header (comportamiento
# actual). Generar con: openssl rand -hex 32
INTERNAL_PROXY_SECRET=""

# INF-08: bucket de Cloud Storage donde vive el catálogo de imágenes —
# next.config.ts arma remotePatterns con esto. Cambia por entorno
# (staging hoy, producción en el Módulo 09).
PRODUCT_IMAGES_BUCKET="eltesoro-product-images-staging"

# INF-08: IPs/orígenes extra permitidos para el servidor de desarrollo
# (probar desde el celular en la misma red WiFi). Separados por coma;
# cambia por máquina, así que va en .env.local, no aquí.
DEV_ALLOWED_ORIGINS=""
